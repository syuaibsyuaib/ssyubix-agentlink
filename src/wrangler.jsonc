{
  "name": "agentlink",
  "main": "index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  // Jangan hidupkan ulang subdomain *.workers.dev setiap deploy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "agentlink.ssyubix.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENTLINK_ROOM",
        "class_name": "AgentLinkRoom"
      },
      {
        "name": "AGENTLINK_REGISTRY",
        "class_name": "AgentLinkRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentLinkRoom", "AgentLinkRegistry"]
    }
  ]
}
